# Postgres connection string (Vercel Postgres / Neon integration sets this
# automatically once you add the storage integration in the Vercel dashboard).
DATABASE_URL=

# The password for /admin. Pick something only the two of you know.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Vercel Blob token for photo uploads (Vercel dashboard sets this automatically
# once you add the Blob storage integration).
BLOB_READ_WRITE_TOKEN=
